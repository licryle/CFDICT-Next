{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://cfdict-next.example/schemas/review.json",
    "title": "Review LLM Dictionary",
    "description": "Schema for review.json - LLM-generated French definitions that require human review",
    "type": "object",
    "additionalProperties": {
        "$ref": "#/definitions/llm_entry"
    },
    "definitions": {
        "llm_entry": {
            "type": "object",
            "required": ["traditional", "simplified", "pinyin", "senses", "confidence", "cc_cedict_version", "llm_model", "prompt_version", "generation_date"],
            "properties": {
                "traditional": {
                    "type": "string",
                    "description": "Traditional Chinese characters"
                },
                "simplified": {
                    "type": "string",
                    "description": "Simplified Chinese characters"
                },
                "pinyin": {
                    "type": "string",
                    "description": "Pinyin pronunciation with tone numbers"
                },
                "senses": {
                    "type": "array",
                    "description": "One sense per CEDICT gloss; the set of source_gloss values must equal the CC-CEDICT gloss set for the entry",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["source_gloss", "french_definition"],
                        "properties": {
                            "source_gloss": {
                                "type": "string",
                                "description": "The individual CEDICT English gloss this French definition was generated for",
                                "minLength": 1
                            },
                            "french_definition": {
                                "type": "string",
                                "description": "Generated French definition for this gloss",
                                "minLength": 1
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "confidence": {
                    "type": "string",
                    "const": "review",
                    "description": "Confidence classification for this entry"
                },
                "cc_cedict_version": {
                    "type": "string",
                    "description": "Version of CC-CEDICT source"
                },
                "llm_model": {
                    "type": "string",
                    "description": "LLM model used for generation"
                },
                "prompt_version": {
                    "type": "string",
                    "description": "Version of the prompt used for generation"
                },
                "generation_date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 date and time of generation"
                }
            }
        }
    }
}