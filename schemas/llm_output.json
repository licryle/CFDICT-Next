{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://cfdict-next.example/schemas/llm_output.json",
    "title": "LLM Generated Entry",
    "description": "Schema for LLM-generated French dictionary entries: one record per lexical entry with one sense per CEDICT gloss (used for both confident and review JSON files)",
    "type": "object",
    "required": ["traditional", "simplified", "pinyin", "senses", "confidence", "cc_cedict_version", "llm_model", "prompt_version", "generation_date"],
    "properties": {
        "traditional": {
            "type": "string",
            "description": "Traditional Chinese characters",
            "minLength": 1
        },
        "simplified": {
            "type": "string",
            "description": "Simplified Chinese characters",
            "minLength": 1
        },
        "pinyin": {
            "type": "string",
            "description": "Pinyin pronunciation with tone numbers",
            "pattern": "^[A-Za-z0-9\\s\\-]*$"
        },
        "senses": {
            "type": "array",
            "description": "One sense per CEDICT gloss; the set of source_gloss values must equal the CC-CEDICT gloss set for the entry (accept/reject criterion)",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["source_gloss", "french_definition"],
                "properties": {
                    "source_gloss": {
                        "type": "string",
                        "description": "The individual CEDICT English gloss this French definition was generated for",
                        "minLength": 1
                    },
                    "french_definition": {
                        "type": "string",
                        "description": "Generated French definition for this gloss",
                        "minLength": 1
                    }
                },
                "additionalProperties": false
            }
        },
        "confidence": {
            "type": "string",
            "enum": ["confident", "review"],
            "description": "Confidence classification for this entry"
        },
        "cc_cedict_version": {
            "type": "string",
            "description": "Version of CC-CEDICT source used"
        },
        "llm_model": {
            "type": "string",
            "description": "LLM model and version used for generation"
        },
        "prompt_version": {
            "type": "string",
            "description": "Version identifier for the prompt template used"
        },
        "generation_date": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of generation"
        }
    }
}
